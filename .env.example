API_KEY=change-me
DATABASE_URL=postgresql+psycopg2://ghostnet:CHANGE_ME@127.0.0.1:5432/ghostnet

# --- Generation backend ------------------------------------------------------
# "ollama" = local /api/chat. "openai" = any OpenAI-compatible /v1 endpoint
# (OpenAI, Groq, Together, OpenRouter, vLLM, LM Studio...).
#
# Local generation on the current VM measured 0.31 tok/s on a 1B model, i.e.
# ~37 tokens inside a 120s timeout. Use "openai" until that is resolved.
LLM_BACKEND=openai

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# Exact model id your provider serves. No default on purpose -- a wrong guess
# should fail loudly at startup rather than 404 on every player message.
OPENAI_MODEL=

# Shared generation tuning (applies to whichever backend is selected)
#
# MAX_OUTPUT_TOKENS must fit inside GEN_TIMEOUT at the backend's actual speed,
# AND inside the bot's own 90s HTTP timeout. Measured on this VM @ 8 threads:
#
#   backend                   tok/s   512 tok    256 tok
#   hosted (openai)           fast    seconds    seconds
#   ollama llama3.2:1b        10.9      47s        23s
#   ollama ghostnet-rp (7B)    2.7     189s        95s   <-- exceeds bot timeout
#
# 512 is safe for hosted and for the 1B. If you switch LLM_BACKEND=ollama with
# a 7B, drop this to ~200 or the bot will time out before the reply lands.
GEN_TIMEOUT=120
MAX_OUTPUT_TOKENS=512
NUM_CTX=8192
# Ollama threads. 6-12 fine, 8 measured best; 24/unset are ~30x slower.
NUM_THREAD=8

# --- Embeddings (always local; a single forward pass is fast enough) ---------
OLLAMA_URL=http://ollama:11434
CHAT_MODEL=llama3.2:1b
EMBED_MODEL=nomic-embed-text

# --- Vector store ------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=ghostnet_docs

# --- RAG tuning --------------------------------------------------------------
MAX_INPUT_TOKENS=6000
RETRIEVAL_TOP_K=2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Provider failover -------------------------------------------------------
# Ordered chain, tried left to right until one answers. Local goes LAST: it
# always responds, so it is a good floor, but it is slowest and weakest.
LLM_CHAIN=openai,openrouter,ollama

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# OpenRouter free-tier model ids carry a ":free" suffix.
OPENROUTER_MODEL=
OPENROUTER_REFERER=https://overworldnex.us
OPENROUTER_TITLE=Overworld Nexus

# --- Memory ------------------------------------------------------------------
# Prompt cost stays flat as conversations grow: recent turns verbatim, older
# turns folded into a rolling summary, everything capped by token budget.
MEMORY_ENABLED=true
MEMORY_SCENE_TOKENS=1500
MEMORY_PLAYER_TOKENS=600
MEMORY_ABSENCE_TOKENS=250
MEMORY_MAX_TURNS=40
MEMORY_COMPACT_AFTER=20
MEMORY_KEEP_VERBATIM=6
MEMORY_SUMMARY_TOKENS=300
MEMORY_MAX_PLAYER_EVENTS=12
MEMORY_MAX_WORLD_EVENTS=8
# Seconds away before a returning player gets caught up on world events (24h).
MEMORY_ABSENCE_SECONDS=86400
# Summarising has nobody waiting on it, so it runs locally and never bills the
# paid provider. This is the main reason memory is cheap to operate.
MEMORY_COMPACT_BACKEND=ollama
TOKEN_CHARS_PER=4
